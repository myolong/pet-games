rules_version = '2';

// 전체 순위표 보안 규칙. Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여 넣고 [게시]한다.
// 누구나 순위를 읽고 새 기록을 올릴 수 있지만, 고치거나 지울 수는 없다.
// 닉네임은 1~8자, 점수는 게임별 상한 이하, 기록 시각은 지금 앞뒤 5분 이내만 받는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore(maxScore) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'at'])
        && d.keys().hasAll(['name', 'score', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 8
        && d.score is int && d.score > 0 && d.score <= maxScore
        && d.at is timestamp
        && d.at > request.time - duration.value(5, 'm')
        && d.at < request.time + duration.value(5, 'm');
    }

    match /scores-snack/{id} {
      allow read: if true;
      allow create: if validScore(3000);
    }

    match /scores-mouse/{id} {
      allow read: if true;
      allow create: if validScore(3000);
    }

    match /scores-tower/{id} {
      allow read: if true;
      allow create: if validScore(3000);
    }
  }
}
